---
import { undefined } from "astro:schema";
import Layout from "../../layouts/Layout.astro";
import {
	getCollection,
	type InferEntrySchema,
	type RenderedContent,
} from "astro:content";

type Post = {
	id: string;
	body?: string;
	collection: "blog";
	data: InferEntrySchema<"blog">;
	rendered?: RenderedContent;
	filePath?: string;
};

const posts = await getCollection("blog");
posts.sort((a, b) => {
	return b.data.date.getTime() - a.data.date.getTime();
});

let bymonth: { id: string; pretty: string; posts: Post[]; }[] = [];
posts.map((post) => {
	let monthId = `${post.data.date.getMonth()}-${post.data.date.getFullYear()}`;
	let monthfound = bymonth.find((i) => {
		return i.id == monthId;
	});
	if (monthfound) {
		monthfound.posts.push(post);
	} else {
		bymonth.push({ id: monthId, pretty: post.data.date.toLocaleString("en-GB", {
			month: "long",
			year: "numeric"

		}), posts: [post] });
	}
});
---

<Layout>
	<div class="container">
		<div class="everything">
			<div class="shiny"></div>
			<div class="headerimagecontainer">
				<img src="/public/images/blog_header.png" />
				<div class="title">Fuckass<br />Blog</div>
			</div>
			{
				bymonth.map((month) => {
					return (
						<div class="month">
							<div>{month.pretty}</div>
							<div class="posts">
								{month.posts.map((post: Post) => {
									return (
										<div class="post">
											{post.data.title}
										</div>
									);
								})}
							</div>
						</div>
					);
				})
			}
		</div>
	</div>
</Layout>

<style>
	.headerimagecontainer {
		height: 15em;
		width: 100%;

		position: relative;
		display: flex;
		align-content: center;

		background-color: var(--bg2);
		border-radius: 10px 10px 0 0;

		border-bottom: #67433055 solid 2px;
	}

	.headerimagecontainer > .title {
		position: absolute;
		text-align: right;
		align-self: center;
		right: 1em;

		font-size: 2.5em;
		font-weight: bold;
	}
	.headerimagecontainer > img {
		margin-top: -2.5em;
		height: 17em;
	}

	.container {
		padding-top: 5em;
		display: flex;
		justify-content: center;

		position: relative;
		left: 0;
		right: 0;
	}

	.postscontainer {
		padding-top: 5em;
		display: flex;
		justify-content: center;

		position: relative;
		left: 0;
		right: 0;
	}

	.month {
		
	}

	.divider {
		width: 100%;
		height: 2px;
		background-color: var(--border);
		content: " ";
	}

	.shiny {
		position: absolute;
		top: 0;
		right: 0;

		width: 100%;
		height: 10em;

		content: " ";
		background: radial-gradient(
			100% 100% at bottom left,
			transparent 100%,
			#d8936e55 150%
		);

		z-index: 10;
	}

	.everything {
		position: relative;
		align-self: center;

		background-color: var(--bg);
		border-radius: 10px;
		border: var(--border) solid 2px;

		display: flex;
		align-items: center;
		flex-direction: column;

		padding-bottom: 1em;

		width: 67vw; /* AHAHAHAHAHAHHAHAHAHHAHA SIX SEVEEENNN SIX SEVEEEN HAHATAATTATTTAHTHAHYAH OH MY FUCKING GOODODO AAAYYYYYHHHYH YYHYHYAAOHOGT */

		gap: 1em;
	}

	.month {
		width: 100%;
	}

	.post {
		background-color: var(--bg2);
		border-radius: 5px;
		width: 90%;

		padding: 1em;
		padding-left: 2.5em;
		padding-right: 2.5em;

		margin-left: 1em;
		margin-right: 1em;

		transition: all 0.2s;

		border-style: solid;
		border-color: #67433055;
		border-width: 2px;
	}

	.post:hover {
		border-color: var(--border);
	}

	.post > h2 {
		font-size: 1.25em;
	}
</style>
