---
import Rain from './rain/Rain.svelte'
import HeroText from './HeroText.svelte'
---

<div class="header-outer">
    <div class="header">
        <HeroText client:only="svelte"/>
        <Rain client:only="svelte"/>
    </div>
    <div class="outer-image">
        <img class="guh" src="/images/franklins-journey.png"/>
    </div>
</div>

<style>
    .header-outer {
        display: flex;
        justify-content: stretch;

        position: relative;
        left: 0;
        right: 0;
    }

    .header {
        background: radial-gradient(200% 100% at bottom right,rgb(238, 130, 6) 0%, rgb(255, 199, 80) 50%, rgb(115, 223, 192)100%);

        z-index: 2;
        
        border-radius: 0 0 1em 0;
        border-width: 2px;
        border-top: 0;
        border-style: solid;
        border-color: var(--border);

        width: 69vw;
        height: 32em;

        padding: 1em;

        position: relative;

        display: flexbox;
        flex-direction: column;
        align-content: end;
        justify-content: end;
    }	

    @media (width <= 80rem) {
        .header {
            width: 100vw;
            border-radius: 0vw;
        }
        .outer-image {
            z-index: 2;
            position: absolute;
        }
    }
    
    .outer-image {
        position: relative;
        flex: auto;
    }

    .guh {
        height:100%;
        right: 0;
        position: absolute;
    }

    .header-title {
        font-size: 5em;
        line-height: 0em;
    }
</style>
